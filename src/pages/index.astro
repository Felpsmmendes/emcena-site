---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Letreiro from '../components/Letreiro.astro';
import Servicos from '../components/Servicos.astro';
import Faixa from '../components/Faixa.astro';
import Prova from '../components/Prova.astro';
import Pacotes from '../components/Pacotes.astro';
import Atracoes from '../components/Atracoes.astro';
import Processo from '../components/Processo.astro';
import QuemFaz from '../components/QuemFaz.astro';
import Faq from '../components/Faq.astro';
import Contratar from '../components/Contratar.astro';
---
<Base
  title="Em Cena Eventos — Bar de drinks e atrações fotográficas para eventos"
  description="Bar de drinks com bartenders profissionais e atrações fotográficas (Totem Retrô, Espelho Mágico, Plataforma 360°) para casamentos, formaturas e eventos em São Paulo e Grande ABC. Nota 5,0 no casamentos.com.br."
>
  <Hero />
  <Letreiro />
  <Servicos />
  <Faixa foto="faixa" alt="Noivos e padrinhos brindando em casamento atendido pela Em Cena" linha1="O bar vira ponto de encontro." linha2="A foto vira lembrança." legenda="Casamento · brinde dos noivos" />
  <Pacotes />
  <Atracoes />
  <Prova />
  <Processo />
  <QuemFaz />
  <Faq />
  <Contratar />
</Base>
