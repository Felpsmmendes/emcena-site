---
import { pacotes, caipirinha } from '../data/site';
const temPreco = pacotes.some((p) => p.aPartirDe);
---
<section id="pacotes" class="pk">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow eyebrow--d" data-reveal>Pacotes de bar</p>
        <h2 class="h2" data-reveal>Cinco cardápios. Escolha um ou monte o seu.</h2>
      </div>
      <p class="head__nota" data-reveal>Valor final conforme número de convidados, local e horário. O Sem Álcool combina com qualquer pacote.</p>
    </div>

    <div class="lista">
      {pacotes.map((p, i) => (
        <details class="pac" data-reveal name="pacote" open={i === 0}>
          <summary>
            <span class="pac__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pac__nome">{p.nome}</span>
            <span class="pac__para">{p.para}<span class="pac__qt">{p.comAlcool.length ? `${p.comAlcool.length} com álcool · ` : ''}{p.semAlcool.length} sem álcool</span></span>
            <span class="pac__copo">{p.copo === 'Vidro' ? 'Copo de vidro' : 'Copo descartável'}</span>
            {temPreco && <span class="pac__preco">{p.aPartirDe ? `a partir de ${p.aPartirDe}` : 'sob consulta'}</span>}
            <span class="pac__ico" aria-hidden="true">+</span>
          </summary>
          <div class="pac__body">
            {p.comAlcool.length > 0 && (<>
              <p class="pac__lbl">{p.comAlcool.length} drinks com álcool</p>
              <ul>{p.comAlcool.map((d) => <li>{d}</li>)}</ul>
            </>)}
            <p class="pac__lbl">{p.semAlcool.length} drinks sem álcool</p>
            <ul>{p.semAlcool.map((d) => <li>{d}</li>)}</ul>
            <a class="link" href={`/orcamento?pacote=${encodeURIComponent(p.nome)}`}>Pedir orçamento com o {p.nome} <span class="arr" aria-hidden="true">›</span></a>
          </div>
        </details>
      ))}
    </div>
    <p class="caip" data-reveal><strong>Festival de Caipirinha incluso</strong> nos pacotes com álcool: {caipirinha.join(', ')}.</p>
  </div>
</section>

<style>
  .pk { background: var(--dark); color: var(--bg); margin-top: clamp(80px, 10vw, 128px); padding-block: clamp(80px, 10vw, 120px); }
  .eyebrow--d { color: var(--gold-soft); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 48px; }
  .head__nota { max-width: 340px; font-size: 15px; line-height: 1.6; color: var(--dark-muted); }
  .lista { border-top: 1px solid rgba(244, 240, 232, .5); }
  .pac { border-bottom: 1px solid var(--dark-line); }
  summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 48px minmax(140px, 1.1fr) 2fr auto 28px; align-items: center; gap: 20px; padding: 26px 0; min-height: 44px; }
  summary::-webkit-details-marker { display: none; }
  .pac__n { font-family: var(--serif); font-size: 22px; color: var(--gold-soft); }
  .pac__nome { font-size: clamp(24px, 2.6vw, 34px); font-weight: 500; letter-spacing: -0.025em; transition: color .3s var(--ease), transform .4s var(--ease); }
  summary:hover .pac__nome { color: var(--gold-soft); transform: translateX(6px); }
  .pac__para { color: #cfc7b8; font-size: 15px; }
  .pac__qt { display: block; margin-top: 4px; font-size: 13px; color: var(--dark-muted); }
  .pac__copo { font-size: 13px; padding: 6px 12px; border: 1px solid var(--dark-line); border-radius: 40px; white-space: nowrap; color: #cfc7b8; }
  .pac__preco { font-family: var(--serif); font-size: 20px; }
  .pac__ico { font-size: 26px; line-height: 1; color: var(--gold-soft); transition: transform .45s var(--ease); justify-self: end; }
  .pac[open] .pac__ico { transform: rotate(45deg); }
  .pac__body { padding: 0 0 30px 68px; animation: abre .6s var(--ease); }
  @keyframes abre { from { opacity: 0; transform: translateY(-8px); } }
  .pac__lbl { font-size: 13px; color: var(--dark-muted); margin-bottom: 12px; }
  .pac__body ul { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pac__body li { padding: 8px 14px; border-radius: 40px; border: 1px solid var(--dark-line); font-size: 14px; color: var(--bg); }
  .pac__body .link { color: var(--gold-soft); }
  .caip { margin-top: 28px; font-size: 15px; color: #cfc7b8; }
  .caip strong { color: var(--bg); }
  @media (max-width: 760px) {
    summary { grid-template-columns: 36px 1fr 28px; row-gap: 6px; }
    .pac__para, .pac__copo, .pac__preco { grid-column: 2 / 3; }
    .pac__copo { justify-self: start; }
    .pac__ico { grid-row: 1; grid-column: 3; }
    .pac__body { padding-left: 56px; }
  }
</style>
