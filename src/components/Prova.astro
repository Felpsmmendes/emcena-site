---
import { prova } from '../data/site';
---
<section class="prova" aria-labelledby="prova-t">
  <div class="wrap prova__in">
    <div data-reveal>
      <p class="eyebrow eyebrow--d" id="prova-t">Quem já contratou</p>
      <p class="prova__nota" data-count={prova.nota} data-dec="1">{prova.nota.toFixed(1).replace('.', ',')}</p>
      <p class="prova__txt">Nota média em <span data-count={prova.avaliacoes}>{prova.avaliacoes}</span> avaliações no {prova.fonte}. {prova.recomendam} dos casais recomendam.</p>
      <p class="prova__selo">{prova.selo} · {prova.seloAnos}</p>
      <a class="link prova__link" href={prova.fonteUrl} target="_blank" rel="noopener">Ler as avaliações <span class="arr" aria-hidden="true">›</span></a>
    </div>
    <div class="prova__deps">
      {prova.depoimentos.map((d) => (
        <figure data-reveal>
          <p class="dep__est" aria-label="5 estrelas">★★★★★</p>
          <p class="dep__t">{d.titulo}</p>
          <blockquote>“{d.texto}”</blockquote>
          <figcaption>{d.autor} · {d.quando}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .prova { background: var(--dark); color: var(--bg); margin-top: clamp(80px, 10vw, 120px); }
  .prova__in { padding-block: clamp(80px, 10vw, 112px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 48px; }
  @media (max-width: 900px) { .prova__in { grid-template-columns: 1fr; } }
  .eyebrow--d { color: var(--gold-soft); }
  .prova__nota { font-family: var(--serif); font-size: clamp(96px, 11vw, 132px); line-height: .9; }
  .prova__txt { margin-top: 16px; font-size: 16px; line-height: 1.6; color: #cfc7b8; }
  .prova__link { margin-top: 20px; color: var(--gold-soft); }
  .prova__deps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 20px; align-content: start; }
  .prova__selo { margin-top: 14px; font-size: 12px; font-weight: 600; letter-spacing: .08em; color: var(--gold-soft); text-transform: uppercase; }
  .dep__est { color: var(--gold-soft); letter-spacing: 3px; font-size: 13px; margin-bottom: 14px; }
  .dep__t { font-weight: 600; font-size: 15px; margin-bottom: 10px; }
  figure { margin: 0; padding: 26px; display: flex; flex-direction: column; border: 1px solid var(--dark-line); border-radius: var(--radius); }
  blockquote { margin: 0; font-family: var(--serif); font-size: 21px; line-height: 1.4; }
  figcaption { margin-top: auto; padding-top: 18px; font-size: 14px; color: var(--dark-muted); }
</style>
