---
import Foto from './Foto.astro';
import { prova, contato, eventosRealizados } from '../data/site';
---
<section class="wrap hero" aria-labelledby="hero-t">
  <div class="hero__txt">
    <p class="eyebrow" data-fade>Nota {prova.nota.toFixed(1).replace('.', ',')} no {prova.fonte} · {contato.regiao}</p>
    <h1 id="hero-t" class="hero__h1">
      <span class="hero-line"><span>Bar de drinks e</span></span>
      <span class="hero-line"><span>atrações para o</span></span>
      <span class="hero-line"><span>seu evento, <em class="s">num</em></span></span>
      <span class="hero-line"><span><em class="s">fornecedor só.</em></span></span>
    </h1>
    <p class="lead hero__lead" data-fade>Bartenders profissionais, cardápio personalizado e atrações como Totem Retrô, Espelho Mágico e Plataforma 360°. Um contrato, uma equipe, nenhum fornecedor a mais para coordenar.</p>
    <div class="hero__ctas" data-fade>
      <a class="btn" href="/orcamento">Pedir orçamento <span class="arr" aria-hidden="true">›</span></a>
      <a class="btn btn--ghost" href="#pacotes">Ver pacotes <span class="arr" aria-hidden="true">›</span></a>
    </div>
    <dl class="hero__nums" data-fade>
      <div><dt>2017</dt><dd>em eventos desde</dd></div>
      <div><dt data-count={prova.nota} data-dec="1">{prova.nota.toFixed(1).replace('.', ',')}</dt><dd>em {prova.avaliacoes} avaliações</dd></div>
      {eventosRealizados
        ? <div><dt>{eventosRealizados}</dt><dd>eventos realizados</dd></div>
        : <div><dt data-count="8">8</dt><dd>serviços para combinar</dd></div>}
    </dl>
  </div>
  <figure class="hero__fig">
    <div data-parallax="0.06">
      <div data-hero-wipe>
        <Foto nome="hero" alt="Bartender da Em Cena servindo drinks para convidados" ratio="4 / 5" wipe={false} eager sizes="(max-width: 900px) 100vw, 560px" sugestao="Foto vertical ou vídeo curto: bartender servindo convidados (1200×1500)" />
      </div>
    </div>
    <figcaption data-fade>Casamento · Bar 360</figcaption>
  </figure>
</section>

<style>
  .hero { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: clamp(40px, 6vw, 72px); align-items: center; padding-block: clamp(40px, 6vw, 72px); }
  .hero__h1 { font-size: clamp(42px, 5.6vw, 76px); line-height: 1.02; letter-spacing: -0.035em; }
  .hero__h1 em { color: var(--gold); }
  .hero-line { display: block; overflow: hidden; padding-bottom: .06em; }
  .hero-line > span { display: block; }
  .hero__lead { margin-top: 26px; max-width: 500px; }
  .hero__ctas { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__nums { margin: 44px 0 0; padding-top: 24px; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .hero__nums dt { font-family: var(--serif); font-size: clamp(32px, 3.4vw, 42px); line-height: 1; }
  .hero__nums dd { margin: 6px 0 0; font-size: 13px; color: var(--muted); }
  .hero__fig { margin: 0; position: relative; }
  [data-hero-wipe] { border-radius: var(--radius); overflow: hidden; }
  .hero__fig figcaption { position: absolute; left: 20px; bottom: 20px; padding: 10px 14px; border-radius: 6px; background: var(--bg); font-size: 13px; }
</style>
