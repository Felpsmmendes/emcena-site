---
/**
 * Foto real quando existir em src/assets/fotos/<nome>.(jpg|jpeg|png|webp),
 * senão um espaço reservado com o tamanho sugerido.
 * Para trocar: salve a foto com o mesmo nome na pasta e rode o build.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fotoPosicao } from '../data/site';

interface Props {
  nome: string;
  alt: string;
  ratio?: string;        // ex.: '4 / 5'
  wipe?: boolean;        // revelação em cortina ao rolar
  zoomHover?: boolean;
  eager?: boolean;
  sizes?: string;
  class?: string;
  sugestao?: string;     // texto do espaço reservado
  escuro?: boolean;      // espaço reservado escuro (para texto claro por cima)
}

const { nome, alt, ratio = '4 / 3', wipe = true, zoomHover = false, eager = false, sizes = '(max-width: 900px) 100vw, 50vw', class: cls = '', sugestao, escuro = false } = Astro.props;

const arquivos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/fotos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const achado = Object.entries(arquivos).find(([p]) => p.split('/').pop()!.replace(/\.[^.]+$/, '') === nome);
const img = achado?.[1].default;
---
<div class:list={['foto', cls, { 'foto--hover': zoomHover }]} style={`aspect-ratio:${ratio}`} data-wipe={wipe ? '' : undefined}>
  <div class="zin">
    {img ? (
      <Image src={img} alt={alt} widths={escuro ? [800, 1200, 1600, 2400] : [480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} class="foto__img" style={`object-position:${fotoPosicao[nome] ?? '50% 50%'}`} />
    ) : (
      <div class:list={['foto__ph', { 'foto__ph--escuro': escuro }]} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
        <span>{sugestao ?? alt}</span>
        <small>src/assets/fotos/{nome}.jpg</small>
      </div>
    )}
  </div>
</div>

<style>
  .foto { position: relative; overflow: hidden; border-radius: var(--radius); background: #d9d1c1; }
  .zin { width: 100%; height: 100%; will-change: transform; }
  .foto__img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .foto--hover:hover .foto__img, :global(.card:hover) .foto--hover .foto__img { transform: scale(1.05); }
  .foto__ph {
    width: 100%; height: 100%; background: var(--ph);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    padding: 20px; text-align: center; color: #4f493f; font-size: 13px;
    transition: transform 1s var(--ease);
  }
  .foto--hover:hover .foto__ph, :global(.card:hover) .foto--hover .foto__ph { transform: scale(1.05); }
  .foto__ph small { font-size: 11px; opacity: .7; }
  .foto__ph--escuro { background: linear-gradient(160deg, #3a3326, #1e1b15); color: rgba(255,255,255,.55); justify-content: flex-start; padding-top: 18%; }
</style>
