---
import { processo } from '../data/site';
---
<section id="processo" class="wrap section">
  <p class="eyebrow" data-reveal>Como funciona</p>
  <h2 class="h2" data-reveal>Do orçamento ao último drink, em quatro passos.</h2>
  <div class="linha" data-line></div>
  <ol class="passos">
    {processo.map((p, i) => (
      <li data-reveal>
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <h3>{p.t}</h3>
        <p>{p.d}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .linha { height: 1px; background: var(--ink); margin-top: 40px; }
  .passos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .passos li { padding: 28px 24px 28px 0; }
  .n { font-family: var(--serif); font-size: 46px; line-height: 1; color: var(--gold); }
  h3 { margin: 16px 0 8px; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  li p { font-size: 15px; line-height: 1.6; color: #4f493f; }
</style>
