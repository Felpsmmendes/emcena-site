---
import { tiposEvento } from '../data/site';
const itens = [...tiposEvento, ...tiposEvento];
---
<div class="mq" aria-label={`Atendemos: ${tiposEvento.join(', ')}`}>
  <div class="mq__track" aria-hidden="true">
    {itens.map((t) => <span class="mq__item">{t}<span class="mq__star">✦</span></span>)}
  </div>
</div>

<style>
  .mq { border-block: 1px solid var(--line); overflow: hidden; }
  .mq__track { display: flex; width: max-content; animation: mq 42s linear infinite; }
  .mq:hover .mq__track { animation-play-state: paused; }
  .mq__item { display: flex; align-items: center; gap: 40px; padding: 22px 20px; white-space: nowrap; font-family: var(--serif); font-size: clamp(22px, 2.2vw, 28px); color: var(--ink-2); }
  .mq__star { color: #b69a55; font-size: 14px; }
  @keyframes mq { to { transform: translateX(-50%); } }
</style>
